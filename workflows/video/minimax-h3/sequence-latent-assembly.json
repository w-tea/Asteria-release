{
  "schema_version": "asteria.video.workflow.v1",
  "workflow_id": "asteria_minimax_h3_sequence_latent_assembly.v1",
  "mode": "sequence_assembly",
  "minimum_comfyui_version": "0.33.1",
  "required_nodes": [
    "VAELoader",
    "AsteriaH3AcceptedLatentStitcher",
    "CreateVideo",
    "SaveVideo"
  ],
  "workflow": {
    "10": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}},
    "11": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}},
    "20": {"class_type": "AsteriaH3AcceptedLatentStitcher", "inputs": {"manifest_path": "${manifest_path}", "video_vae": ["10", 0], "audio_vae": ["11", 0], "fps": "${fps}", "contract_version": "asteria.video.sequence.latent-assembly.v1"}},
    "30": {"class_type": "CreateVideo", "inputs": {"images": ["20", 0], "audio": ["20", 1], "fps": "${fps}", "bit_depth": 8}},
    "31": {"class_type": "SaveVideo", "inputs": {"video": ["30", 0], "filename_prefix": "${output_prefix}", "format": "auto", "codec": "auto"}}
  },
  "bindings": {
    "manifest_path": "20.inputs.manifest_path",
    "stitch_fps": "20.inputs.fps",
    "video_fps": "30.inputs.fps",
    "video_vae_name": "10.inputs.vae_name",
    "audio_vae_name": "11.inputs.vae_name",
    "output_prefix": "31.inputs.filename_prefix"
  }
}

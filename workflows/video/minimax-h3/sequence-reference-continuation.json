{
  "schema_version": "asteria.video.workflow.v1",
  "workflow_id": "asteria_minimax_h3_sequence_reference.v1",
  "mode": "sequence",
  "minimum_comfyui_version": "0.30.0",
  "required_nodes": ["LoadVideo", "GetVideoComponents", "UNETLoader", "CLIPLoader", "VAELoader", "MiniMaxH3ReferenceToVideo", "MiniMaxH3SigmaShift", "SamplerCustomAdvanced", "VAEDecode", "VAEDecodeAudio", "CreateVideo", "SaveVideo"],
  "workflow": {
    "asteria-sequence-video": {"class_type": "LoadVideo", "inputs": {"file": "${context_video_filename}"}},
    "asteria-sequence-video-components": {"class_type": "GetVideoComponents", "inputs": {"video": ["asteria-sequence-video", 0]}},
    "10": {"class_type": "UNETLoader", "inputs": {"unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors", "weight_dtype": "default"}},
    "20": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default"}},
    "30": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}},
    "31": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}},
    "40": {"class_type": "MiniMaxH3ReferenceToVideo", "inputs": {"clip": ["20", 0], "vae": ["30", 0], "audio_vae": ["31", 0], "prompt": "${prompt}", "width": "${width}", "height": "${height}", "length": "${frame_count}", "ref_image_size": "match", "ref_videos.ref_video_0": ["asteria-sequence-video-components", 0], "ref_video_audios.ref_video_audio_0": ["asteria-sequence-video-components", 1]}},
    "50": {"class_type": "MiniMaxH3SigmaShift", "inputs": {"model": ["10", 0], "shift_video": 12.0, "shift_audio": 3.0}},
    "60": {"class_type": "BasicGuider", "inputs": {"model": ["50", 0], "conditioning": ["40", 0]}},
    "61": {"class_type": "RandomNoise", "inputs": {"noise_seed": "${seed}"}},
    "62": {"class_type": "BasicScheduler", "inputs": {"model": ["50", 0], "scheduler": "beta", "steps": 50, "denoise": 1.0}},
    "63": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "res_multistep"}},
    "70": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["61", 0], "guider": ["60", 0], "sampler": ["63", 0], "sigmas": ["62", 0], "latent_image": ["40", 1]}},
    "80": {"class_type": "VAEDecode", "inputs": {"samples": ["70", 0], "vae": ["30", 0]}},
    "81": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["70", 0], "vae": ["31", 0]}},
    "90": {"class_type": "CreateVideo", "inputs": {"images": ["80", 0], "audio": ["81", 0], "fps": 24, "bit_depth": 8}},
    "91": {"class_type": "SaveVideo", "inputs": {"video": ["90", 0], "filename_prefix": "${output_prefix}", "format": "auto", "codec": "auto"}}
  },
  "bindings": {
    "context_video_filename": "asteria-sequence-video.inputs.file",
    "prompt": "40.inputs.prompt",
    "width": "40.inputs.width",
    "height": "40.inputs.height",
    "frame_count": "40.inputs.length",
    "fps": "90.inputs.fps",
    "seed": "61.inputs.noise_seed",
    "diffusion_model_name": "10.inputs.unet_name",
    "text_encoder_name": "20.inputs.clip_name",
    "video_vae_name": "30.inputs.vae_name",
    "audio_vae_name": "31.inputs.vae_name",
    "video_shift": "50.inputs.shift_video",
    "audio_shift": "50.inputs.shift_audio",
    "steps": "62.inputs.steps",
    "scheduler": "62.inputs.scheduler",
    "sampler": "63.inputs.sampler_name",
    "output_prefix": "91.inputs.filename_prefix"
  },
  "dynamic_bindings": {
    "loras": {
      "class_type": "LoraLoaderModelOnly",
      "source_node_id": "10",
      "target_node_id": "50",
      "target_input": "model",
      "model_input": "model",
      "lora_name_input": "lora_name",
      "strength_input": "strength_model",
      "output_index": 0
    }
  }
}
